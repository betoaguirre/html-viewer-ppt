<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:type="ContentApp">

  <Id>78cd38eb-fd45-4d43-8d64-4a3c0aa80232</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>EREA Consulting Group</ProviderName>
  <DefaultLocale>es-MX</DefaultLocale>

  <DisplayName DefaultValue="HTML Viewer (web)"/>
  <Description DefaultValue="Inserta paginas HTML interactivas dentro de una diapositiva. El HTML se guarda dentro del propio .pptx."/>

  <IconUrl DefaultValue="https://betoaguirre.github.io/html-viewer-ppt/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://betoaguirre.github.io/html-viewer-ppt/icon-80.png"/>

  <Hosts>
    <Host Name="Presentation"/>
  </Hosts>

  <DefaultSettings>
    <SourceLocation DefaultValue="https://betoaguirre.github.io/html-viewer-ppt/viewer.html"/>
    <RequestedWidth>800</RequestedWidth>
    <RequestedHeight>500</RequestedHeight>
  </DefaultSettings>

  <Permissions>ReadWriteDocument</Permissions>
</OfficeApp>
